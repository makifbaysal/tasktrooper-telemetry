<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(LibraryTargetFrameworks)</TargetFrameworks>
    <Description>TaskTrooper Telemetry for Entity Framework Core: EF Core command spans via OpenTelemetry instrumentation, exported with the trooper.* conventions.</Description>
    <PackageTags>$(PackageTags);efcore;entityframeworkcore;database</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" />
    <ProjectReference Include="..\TaskTrooper.Telemetry\TaskTrooper.Telemetry.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TaskTrooper.Telemetry.Tests" />
  </ItemGroup>
</Project>

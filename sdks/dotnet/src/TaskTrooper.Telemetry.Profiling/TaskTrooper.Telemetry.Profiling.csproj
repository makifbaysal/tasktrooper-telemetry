<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(LibraryTargetFrameworks)</TargetFrameworks>
    <Description>TaskTrooper Telemetry continuous profiler for .NET: in-process EventPipe (CPU, wall, allocations, lock contention) with endpoint (route) attribution, uploaded in folded format.</Description>
    <PackageTags>$(PackageTags);profiling;eventpipe</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\TaskTrooper.Telemetry\TaskTrooper.Telemetry.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.NETCore.Client" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TaskTrooper.Telemetry.Profiling.Tests" />
  </ItemGroup>
</Project>

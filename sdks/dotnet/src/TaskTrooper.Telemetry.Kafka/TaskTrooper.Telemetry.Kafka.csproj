<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(LibraryTargetFrameworks)</TargetFrameworks>
    <Description>TaskTrooper Telemetry for Confluent.Kafka: consumer entry spans and traced producers with W3C trace context and caller propagation in message headers.</Description>
    <PackageTags>$(PackageTags);kafka;confluent;messaging</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Confluent.Kafka" />
    <ProjectReference Include="..\TaskTrooper.Telemetry\TaskTrooper.Telemetry.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TaskTrooper.Telemetry.Tests" />
  </ItemGroup>
</Project>

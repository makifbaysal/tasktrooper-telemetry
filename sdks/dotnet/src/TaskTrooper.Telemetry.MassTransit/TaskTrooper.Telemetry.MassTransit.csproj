<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(LibraryTargetFrameworks)</TargetFrameworks>
    <Description>TaskTrooper Telemetry for MassTransit: maps MassTransit diagnostics to TaskTrooper consumer conventions (trooper.process). No MassTransit package dependency.</Description>
    <PackageTags>$(PackageTags);masstransit;messaging</PackageTags>
  </PropertyGroup>
  <ItemGroup>

    <ProjectReference Include="..\TaskTrooper.Telemetry\TaskTrooper.Telemetry.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TaskTrooper.Telemetry.Tests" />
  </ItemGroup>
</Project>

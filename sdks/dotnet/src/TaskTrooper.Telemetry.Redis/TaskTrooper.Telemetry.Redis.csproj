<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(LibraryTargetFrameworks)</TargetFrameworks>
    <Description>TaskTrooper Telemetry for StackExchange.Redis: Redis command spans via OpenTelemetry instrumentation.</Description>
    <PackageTags>$(PackageTags);redis;stackexchange.redis</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Instrumentation.StackExchangeRedis" />
    <ProjectReference Include="..\TaskTrooper.Telemetry\TaskTrooper.Telemetry.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TaskTrooper.Telemetry.Tests" />
  </ItemGroup>
</Project>

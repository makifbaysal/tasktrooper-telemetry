<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(LibraryTargetFrameworks)</TargetFrameworks>
    <Description>TaskTrooper Telemetry for RabbitMQ.Client 7: consumer conventions on the built-in subscriber spans, retry attempt from x-delivery-count/x-death, caller propagation.</Description>
    <PackageTags>$(PackageTags);rabbitmq;amqp;messaging</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="RabbitMQ.Client" />
    <ProjectReference Include="..\TaskTrooper.Telemetry\TaskTrooper.Telemetry.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TaskTrooper.Telemetry.Tests" />
  </ItemGroup>
</Project>

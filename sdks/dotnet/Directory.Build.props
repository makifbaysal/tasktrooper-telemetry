<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- beta OTel instrumentations are referenced only from opt-in packages -->
    <NoWarn>$(NoWarn);NU5104;CS1591</NoWarn>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <LibraryTargetFrameworks>net8.0;net9.0;net10.0</LibraryTargetFrameworks>
  </PropertyGroup>

  <!-- NuGet package metadata (tests and samples set IsPackable=false). Release: .github/workflows/release-dotnet.yml -->
  <PropertyGroup>
    <!-- default for local builds; the release workflow passes /p:Version=<tag version> -->
    <Version>0.1.0</Version>
    <Authors>Mehmet Akif Baysal</Authors>
    <Company>TaskTrooper</Company>
    <Product>TaskTrooper Telemetry</Product>
    <Copyright>Copyright (c) Mehmet Akif Baysal</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://tasktrooper.ai</PackageProjectUrl>
    <RepositoryUrl>https://github.com/makifbaysal/tasktrooper-telemetry</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageTags>tasktrooper;opentelemetry;otel;observability;apm;tracing;metrics;logging;monitoring</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true' or '$(CI)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>
</Project>

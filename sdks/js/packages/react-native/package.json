{
  "name": "@tasktrooper/react-native",
  "version": "0.1.0",
  "description": "TaskTrooper Telemetry RUM SDK for React Native.",
  "keywords": [
    "tasktrooper",
    "observability",
    "monitoring",
    "react-native",
    "rum",
    "mobile",
    "crash-reporting"
  ],
  "license": "Apache-2.0",
  "author": "Mehmet Akif Baysal",
  "homepage": "https://telemetry.tasktrooper.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/makifbaysal/tasktrooper-telemetry.git",
    "directory": "sdks/js/packages/react-native"
  },
  "bugs": {
    "url": "https://github.com/makifbaysal/tasktrooper-telemetry/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "android/build.gradle",
    "android/consumer-rules.pro",
    "android/src",
    "ios",
    "trooper-react-native.podspec",
    "react-native.config.cjs",
    "README.md",
    "LICENSE",
    "!**/__tests__",
    "!android/build",
    "!ios/build"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@tasktrooper/core": "workspace:*"
  },
  "peerDependencies": {
    "react-native": ">=0.72",
    "@react-native-async-storage/async-storage": ">=1.17",
    "react-native-device-info": ">=10"
  },
  "peerDependenciesMeta": {
    "@react-native-async-storage/async-storage": {
      "optional": true
    },
    "react-native-device-info": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "tsup": "^9.0.0",
    "vitest": "^5.0.5",
    "@types/node": "^26.6.5"
  },
  "react-native": "./dist/index.js",
  "codegenConfig": {
    "name": "TrooperRumSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "dev.tasktrooper.reactnative"
    },
    "ios": {
      "modulesProvider": {
        "TrooperRum": "TrooperRum"
      }
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}

{
  "name": "@tasktrooper/angular",
  "version": "0.1.0",
  "description": "Angular (17+) providers for @tasktrooper/browser.",
  "keywords": [
    "tasktrooper",
    "observability",
    "monitoring",
    "angular",
    "rum"
  ],
  "license": "Apache-2.0",
  "author": "Mehmet Akif Baysal",
  "homepage": "https://telemetry.tasktrooper.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/makifbaysal/tasktrooper-telemetry.git",
    "directory": "sdks/js/packages/angular"
  },
  "bugs": {
    "url": "https://github.com/makifbaysal/tasktrooper-telemetry/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@tasktrooper/browser": "workspace:*",
    "@tasktrooper/core": "workspace:*"
  },
  "peerDependencies": {
    "@angular/core": ">=17",
    "@angular/router": ">=17"
  },
  "peerDependenciesMeta": {},
  "devDependencies": {
    "typescript": "5.9.3",
    "tsup": "^9.0.0",
    "vitest": "^5.0.5",
    "@angular/core": "^22.0.0",
    "@angular/common": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "rxjs": "^7.8.0",
    "happy-dom": "^21.0.0",
    "@types/node": "^26.6.5"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}

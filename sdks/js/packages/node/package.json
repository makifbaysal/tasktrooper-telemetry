{
  "name": "@trooper/node",
  "version": "0.1.0",
  "description": "TaskTrooper Telemetry distribution of OpenTelemetry for Node.js: OTLP export, trooper.* conventions, framework and queue helpers.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "./dist/register.js",
    "./dist/register.cjs"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./register": {
      "import": {
        "types": "./dist/register.d.ts",
        "default": "./dist/register.js"
      },
      "require": {
        "types": "./dist/register.d.cts",
        "default": "./dist/register.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/core": "^3.0.0",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.300.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.300.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.300.0",
    "@opentelemetry/instrumentation": "^0.300.0",
    "@opentelemetry/instrumentation-amqplib": "^0.71.0",
    "@opentelemetry/instrumentation-express": "^0.72.0",
    "@opentelemetry/instrumentation-http": "^0.300.0",
    "@opentelemetry/instrumentation-ioredis": "^0.72.0",
    "@opentelemetry/instrumentation-kafkajs": "^0.33.0",
    "@opentelemetry/instrumentation-koa": "^0.72.0",
    "@opentelemetry/instrumentation-mongodb": "^0.77.0",
    "@opentelemetry/instrumentation-mysql2": "^0.70.0",
    "@opentelemetry/instrumentation-nestjs-core": "^0.71.0",
    "@opentelemetry/instrumentation-pg": "^0.77.0",
    "@opentelemetry/instrumentation-pino": "^0.70.0",
    "@opentelemetry/instrumentation-redis": "^0.72.0",
    "@opentelemetry/instrumentation-undici": "^0.34.0",
    "@opentelemetry/instrumentation-winston": "^0.69.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-logs": "^3.0.0",
    "@opentelemetry/sdk-metrics": "^3.0.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@opentelemetry/sdk-trace": "^3.0.0",
    "@opentelemetry/winston-transport": "^0.35.0",
    "import-in-the-middle": "^3.5.3"
  },
  "devDependencies": {
    "@opentelemetry/context-async-hooks": "^3.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "express": "^5.3.0",
    "pino": "^10.4.0",
    "tsup": "^9.0.0",
    "typescript": "5.9.3",
    "vitest": "^5.0.5"
  }
}

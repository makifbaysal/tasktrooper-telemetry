# Api (ADR-013, ADR-028): the dashboard reads only real data; sign-in via the tt_session cookie (OIDC or TT_AUTH_DEV dev login)
VITE_API_URL=http://localhost:8080
# Public ingest URL shown in SDK setup snippets (DSN = <scheme>://<ingest-key>@<host>/<project>); same as the api's TT_PUBLIC_INGEST_URL
# VITE_INGEST_URL=http://localhost:4318

# Self-observability (ADR-027, .ai/contracts.md §27) — RUM of the dashboard itself as app `tt-web`.
# Unset (default): the SDK is not loaded at all. `make self` prints the local value.
# VITE_TROOPER_DSN=http://<ingest-key>@localhost:4318/<self-project-id>
# Environment tag (default: Vite mode — development / production); release (default: package version + git sha)
# VITE_TROOPER_ENV=development
# VITE_TROOPER_VERSION=
# Fraction of sessions sending RUM (default 1)
# VITE_TROOPER_SAMPLE_RATE=1
# traceparent/tracestate/baggage on api calls (default on; needs the api CORS of ADR-027 — false for an older api)
# VITE_TROOPER_TRACE_PROPAGATION=true
# Session replay (@trooper/replay, all text + inputs masked). Both default 0 = replay off and its chunk not loaded.
# VITE_TROOPER_REPLAY_SAMPLE_RATE=0            # sessions recorded from the start
# VITE_TROOPER_REPLAY_ON_ERROR_SAMPLE_RATE=0   # other sessions buffer the last 60 s and send it on the first error

# Template of the DEMO_ENV secret (GitHub → Settings → Environments → demo). The workflow writes it to deploy/.env.
# Generate the two keys once: openssl rand -base64 32 / openssl rand -hex 32. Never commit real values.
TT_SECRETS_KEY=
TT_INTERNAL_TOKEN=
TT_PUBLIC_APP_URL=https://telemetry.tasktrooper.ai
TT_WEB_URL=https://telemetry.tasktrooper.ai
TT_PUBLIC_API_URL=https://telemetry-api.tasktrooper.ai
TT_PUBLIC_INGEST_URL=https://telemetry-ingest.tasktrooper.ai
# Google sign-in (OAuth client, redirect URI https://telemetry-api.tasktrooper.ai/api/v1/auth/callback)
TT_OIDC_ISSUER=https://accounts.google.com
TT_OIDC_CLIENT_ID=
TT_OIDC_CLIENT_SECRET=

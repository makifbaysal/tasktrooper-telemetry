# Dashboard static files for the demo (TLS is terminated by Cloudflare; the tunnel talks plain HTTP to 127.0.0.1:8081)
:80 {
	root * /srv
	encode zstd gzip
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-cache"
	try_files {path} /index.html
	file_server
}

# Dashboard static files for the demo (TLS is terminated by Cloudflare; the tunnel talks plain HTTP to 127.0.0.1:8081)
:80 {
	root * /srv
	encode zstd gzip
	# hashed build files never change; every other path (SPA routes → index.html) must be revalidated after a deploy
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@pages not path /assets/*
	header @pages Cache-Control "no-cache"
	try_files {path} /index.html
	file_server
}
